---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import CTA from '@/components/CTA.astro';
import { divisions } from '@/data/divisions';

const approach = [
  { title: 'Слушаем', text: 'Уточняем контекст, цели, ограничения и доступные факты.' },
  { title: 'Разбираем', text: 'Ищем системные причины, взаимосвязи и потери.' },
  { title: 'Проектируем', text: 'Определяем целевой процесс, роли, данные и решения.' },
  { title: 'Внедряем', text: 'Работаем вместе с командой и проверяем практику.' },
  { title: 'Улучшаем', text: 'Измеряем, корректируем и закрепляем изменения.' },
];
---

<BaseLayout title="О VAV Group — подход и система работы" description="VAV Group объединяет развитие бизнеса, продажи, автоматизацию, AI и практический консалтинг в единую систему изменений.">
  <section class="about-hero">
    <div class="container"><Breadcrumbs items={[{ label: 'VAV Group', href: '/' }, { label: 'О группе' }]} /><div class="about-hero__grid"><div><p class="eyebrow"><span></span> О VAV Group</p><h1>Бизнес-системы должны работать не только на схеме — но и в ежедневной практике.</h1></div><p>VAV Group — зонтичный бренд на пересечении развития бизнеса, продаж, автоматизации, AI, консалтинга, деловой экосистемы, обучения и production. Мы соединяем эти компетенции вокруг конкретной бизнес-задачи.</p></div></div>
  </section>

  <section class="section philosophy">
    <div class="container"><SectionHeader eyebrow="Философия" title="Анализируем. Проектируем. Внедряем. Улучшаем." text="Не создаём видимость трансформации длинным списком инициатив. Помогаем выбрать последовательность изменений, которую бизнес способен реализовать и контролировать." /><div class="principles"><article><span>01</span><h3>Бизнес-задача первой</h3><p>Инструмент имеет смысл только в контексте ограничения и требуемого результата.</p></article><article><span>02</span><h3>Факты до обещаний</h3><p>Выводы опираются на процессы, данные, наблюдения и проверяемые гипотезы.</p></article><article><span>03</span><h3>Внедрение — часть решения</h3><p>Учитываем роли, привычки команды, управление изменениями и последующий контроль.</p></article></div></div>
  </section>

  <section class="section section--muted"><div class="container"><SectionHeader eyebrow="Как работаем" title="Единый цикл от контекста до улучшения." text="Глубина и состав этапов зависят от задачи, но логика сохраняется." /><ProcessSteps steps={approach} /></div></section>

  <section class="section expertise"><div class="container"><SectionHeader eyebrow="Экспертиза" title="Восемь направлений, которые можно развивать независимо." text="Архитектура VAV Group готова к добавлению новых divisions без пересборки всей системы бренда." /><div class="expertise-grid">{divisions.map((division) => <a href={division.href}><span>{division.number}</span><div><h3>{division.name}</h3><p>{division.cardOutcome}</p></div><b aria-hidden="true">↗</b></a>)}</div></div></section>

  <section class="section founder-section">
    <div class="container founder-grid">
      <div class="founder-placeholder"><span>FOUNDER / VAV GROUP</span><b>VS</b><small>BUSINESS DEVELOPMENT<br />SALES · OPERATIONS · AUTOMATION</small></div>
      <div>
        <p class="eyebrow"><span></span> Основатель</p>
        <h2>Валентин Стратила</h2>
        <p class="founder-position">Business Development · B2B Sales · Commercial Operations · Automation</p>
        <p>Профессиональный фокус — развитие бизнеса, сложные B2B-продажи, коммерческие операции и перестройка процессов. На сайте публикуются только согласованные факты; неподтверждённые показатели, работодатели и конфиденциальные детали не раскрываются.</p>
        <a class="founder-link" href="/cases">Посмотреть практический опыт <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section section--muted origin-section">
    <div class="container">
      <SectionHeader eyebrow="Прозрачность" title="Опыт основателя и проекты VAV Group — разные категории." text="Мы явно отмечаем происхождение каждого кейса, чтобы не представлять работодателя, партнёра или участника переговоров как клиента VAV Group." />
      <div class="origin-grid">
        <article><span>01</span><h3>Опыт основателя</h3><p>Задачи, выполненные Валентином в исполнительной или коммерческой роли до либо вне клиентского проекта VAV Group. Компания-работодатель не становится клиентом VAV Group.</p></article>
        <article><span>02</span><h3>Проекты VAV Group</h3><p>Работы, выполненные в рамках подтверждённого проекта VAV Group. Такие кейсы публикуются только после проверки фактов, статуса отношений и разрешённого уровня раскрытия.</p></article>
      </div>
    </div>
  </section>
  <CTA title="Нужен взгляд на бизнес как на связанную систему?" label="Обсудить задачу" />
</BaseLayout>

<style>
  .about-hero { padding-block: 2rem clamp(5rem,10vw,9rem); background: var(--surface-dark); color: #fff; }
  .about-hero :global(.breadcrumbs), .about-hero :global(.breadcrumbs a) { color: #839199; }
  .about-hero__grid { display: grid; grid-template-columns: 1.3fr .7fr; align-items: end; gap: clamp(3rem,8vw,8rem); margin-top: clamp(4rem,8vw,7rem); }
  .about-hero :global(.eyebrow) { color: #aeb9bf; }.about-hero h1 { max-width: 16ch; margin-top: 1.4rem; font-size: var(--step-5); line-height: 1.01; letter-spacing: -.055em; }.about-hero__grid > p { color: #afbbc0; font-size: var(--step-1); line-height: 1.7; }
  .principles { display: grid; grid-template-columns: repeat(3,1fr); border: 1px solid var(--line); }.principles article { min-height: 18rem; padding: 1.6rem; border-right: 1px solid var(--line); }.principles article:last-child { border-right: 0; }.principles span { color: var(--accent); font-family: var(--mono); font-size: .65rem; }.principles h3 { margin-top: 4rem; font-size: 1.3rem; }.principles p { margin-top: .8rem; color: var(--muted); font-size: .86rem; line-height: 1.6; }
  .expertise-grid { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--line); }.expertise-grid a { display: grid; grid-template-columns: 3rem 1fr auto; gap: 1rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); }.expertise-grid a:nth-child(odd) { padding-right: 2rem; border-right: 1px solid var(--line); }.expertise-grid a:nth-child(even) { padding-left: 2rem; }.expertise-grid a > span { color: var(--accent); font-family: var(--mono); font-size: .65rem; }.expertise-grid h3 { font-size: 1.05rem; }.expertise-grid p { margin-top: .35rem; color: var(--muted); font-size: .78rem; line-height: 1.5; }.expertise-grid b { color: var(--accent); font-weight: 400; }.expertise-grid a:hover h3 { color: var(--accent); }
  .founder-section { border-top: 1px solid var(--line); }.founder-grid { display: grid; grid-template-columns: .8fr 1.2fr; align-items: center; gap: clamp(3rem,9vw,9rem); }.founder-placeholder { aspect-ratio: 4/5; display: grid; place-items: center; align-content: center; gap: 2rem; padding: 2rem; border: 1px solid var(--line); color: #fff; background: var(--surface-dark); text-align: center; }.founder-placeholder > span, .founder-placeholder small { color: #819098; font-family: var(--mono); font-size: .58rem; line-height: 1.6; letter-spacing: .1em; }.founder-placeholder b { font-size: clamp(4rem,9vw,8rem); letter-spacing: -.07em; }.founder-grid h2 { margin-top: 1.2rem; font-size: var(--step-3); letter-spacing: -.04em; }.founder-grid > div:last-child > p:not(.eyebrow) { margin-top: 1rem; color: var(--muted-strong); line-height: 1.65; }.founder-position { color: var(--accent) !important; font-family: var(--mono); font-size: .7rem; letter-spacing: .05em; text-transform: uppercase; }.founder-link { display: flex; justify-content: space-between; max-width: 26rem; margin-top: 2rem; padding-block: 1rem; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: .82rem; font-weight: 650; }.founder-link span { color: var(--accent); }
  .origin-grid { display: grid; grid-template-columns: 1fr 1fr; border: 1px solid var(--line); }.origin-grid article { min-height: 19rem; padding: clamp(1.5rem,3vw,2.5rem); }.origin-grid article + article { border-left: 1px solid var(--line); }.origin-grid span { color: var(--accent); font-family: var(--mono); font-size: .62rem; }.origin-grid h3 { margin-top: 4rem; font-size: var(--step-2); letter-spacing: -.03em; }.origin-grid p { max-width: 34rem; margin-top: 1rem; color: var(--muted-strong); font-size: .86rem; line-height: 1.65; }
  @media (max-width: 800px) { .about-hero__grid, .founder-grid { grid-template-columns: 1fr; }.principles { grid-template-columns: 1fr; }.principles article { min-height: auto; border-right: 0; border-bottom: 1px solid var(--line); }.principles article:last-child { border-bottom: 0; }.principles h3 { margin-top: 2.5rem; }.founder-placeholder { max-width: 28rem; } }
  @media (max-width: 600px) { .expertise-grid, .origin-grid { grid-template-columns: 1fr; }.expertise-grid a:nth-child(odd), .expertise-grid a:nth-child(even) { padding-inline: 0; border-right: 0; }.origin-grid article { min-height: auto; }.origin-grid article + article { border-top: 1px solid var(--line); border-left: 0; }.origin-grid h3 { margin-top: 2.5rem; } }
</style>
