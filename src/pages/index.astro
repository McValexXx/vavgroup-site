---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHeader from '@/components/SectionHeader.astro';
import DivisionCard from '@/components/DivisionCard.astro';
import ProcessSteps from '@/components/ProcessSteps.astro';
import CaseCard from '@/components/CaseCard.astro';
import AuditCard from '@/components/AuditCard.astro';
import CTA from '@/components/CTA.astro';
import { divisions } from '@/data/divisions';
import { cases } from '@/data/cases';

const problems = [
  'Продажи зависят от отдельных менеджеров',
  'Лиды и следующие действия теряются',
  'CRM не отражает реальную работу',
  'Процессы держатся на ручных операциях',
  'Отчётность собрана из разных источников',
  'Руководителям не хватает прозрачности',
  'AI-инструменты не связаны с процессами',
  'Рост создаёт операционный хаос',
];

const systemSteps = [
  { title: 'Диагностика', text: 'Находим ограничения, факты и точки потерь.' },
  { title: 'Проектирование', text: 'Описываем целевой процесс, роли и метрики.' },
  { title: 'Внедрение', text: 'Настраиваем инструменты и рабочий порядок.' },
  { title: 'Автоматизация', text: 'Убираем повторяемую ручную работу.' },
  { title: 'Обучение', text: 'Передаём команде практику и стандарты.' },
  { title: 'Оптимизация', text: 'Измеряем качество и устраняем отклонения.' },
  { title: 'Масштабирование', text: 'Готовим систему к росту нагрузки.' },
];

const improvementAreas = [
  { name: 'Продажи', code: 'SALE', items: ['Конверсия', 'Скорость ответа', 'Работа с лидами', 'Follow-up'] },
  { name: 'Операции', code: 'OPS', items: ['Скорость процессов', 'Прозрачность', 'Отчётность', 'Меньше ручной работы'] },
  { name: 'Управление', code: 'CTRL', items: ['Dashboards', 'KPI', 'Ответственность', 'Прогнозирование'] },
  { name: 'AI', code: 'AI', items: ['Агенты и ассистенты', 'Квалификация лидов', 'Базы знаний', 'Аналитика'] },
];

const audits = ['Sales Audit', 'CRM Audit', 'Automation Audit', 'Business Process Audit', 'AI Readiness Audit'];
---

<BaseLayout
  title="VAV Group — продажи, автоматизация и AI как система роста"
  description="VAV Group помогает компаниям находить точки роста, выстраивать продажи, автоматизировать процессы и внедрять AI в единую работающую систему."
>
  <section class="hero">
    <div class="container hero__grid">
      <div class="hero__content">
        <p class="eyebrow"><span></span> Business. Sales. Automation. Growth.</p>
        <h1>Строим системы, которые помогают бизнесу <em>продавать больше и масштабироваться.</em></h1>
        <p class="hero__lead">VAV Group объединяет продажи, автоматизацию, AI, консалтинг и развитие бизнеса в одну управляемую систему роста.</p>
        <div class="hero__actions"><a class="button" href="/contacts">Обсудить задачу <span aria-hidden="true">↗</span></a><a class="button button--secondary" href="#directions">Посмотреть направления</a></div>
      </div>
      <div class="system-map" aria-label="Система VAV Group объединяет продажи, процессы, данные и AI вокруг роста бизнеса">
        <div class="system-map__axis system-map__axis--x"></div><div class="system-map__axis system-map__axis--y"></div>
        <span class="system-map__label label-a">ПРОДАЖИ</span><span class="system-map__label label-b">ПРОЦЕССЫ</span><span class="system-map__label label-c">ДАННЫЕ</span><span class="system-map__label label-d">AI</span>
        <div class="system-map__core"><b>VAV</b><small>СИСТЕМА<br />РОСТА</small></div><div class="system-map__orbit orbit-one"></div><div class="system-map__orbit orbit-two"></div>
      </div>
    </div>
    <div class="container hero__foot"><p>Диагностируем</p><span></span><p>Проектируем</p><span></span><p>Внедряем</p><span></span><p>Улучшаем</p></div>
  </section>

  <section class="section problems-section">
    <div class="container">
      <SectionHeader eyebrow="Системные ограничения" title="Рост бизнеса часто упирается не в людей — а в систему." text="Отдельные симптомы складываются в одну проблему: процессы, данные, инструменты и управление не поддерживают новый масштаб." />
      <ol class="problems-grid">{problems.map((problem, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{problem}</p></li>)}</ol>
    </div>
  </section>

  <section id="approach" class="section section--muted">
    <div class="container">
      <SectionHeader eyebrow="VAV System" title="От диагностики до масштабирования — одна логика изменений." text="Не передаём бизнесу разрозненные рекомендации. Каждый этап создаёт основу для следующего и заканчивается понятным результатом." />
      <div class="seven-steps"><ProcessSteps steps={systemSteps} /></div>
    </div>
  </section>

  <section class="section cases-section">
    <div class="container">
      <SectionHeader eyebrow="Практический опыт" title="Реальные задачи. Проверяемые формулировки." text="Показываем контекст, роль и логику решения без раскрытия конфиденциальных данных и неподтверждённых результатов." />
      <div class="cases-grid">{cases.map((item) => <CaseCard item={item} compact />)}</div>
      <div class="cases-section__actions"><a class="button button--secondary" href="/cases">Все кейсы <span aria-hidden="true">↗</span></a></div>
    </div>
  </section>

  <section id="directions" class="section directions-section">
    <div class="container">
      <SectionHeader eyebrow="Направления VAV Group" title="Специализированные компетенции. Единая бизнес-архитектура." text="Можно начать с одного направления или собрать связанную программу под задачу компании." />
      <div class="directions-grid">{divisions.map((division) => <DivisionCard division={division} />)}</div>
    </div>
  </section>

  <section class="section section--dark improve-section">
    <div class="container">
      <SectionHeader light eyebrow="Что улучшаем" title="Показатели, процессы и управляемость." text="Набор метрик зависит от проекта и доступных данных. Мы фиксируем исходную точку до выводов об эффекте." />
      <div class="improve-grid">{improvementAreas.map((area, index) => <article><div><span>{String(index + 1).padStart(2, '0')}</span><b>{area.code}</b></div><h3>{area.name}</h3><ul>{area.items.map((item) => <li>{item}</li>)}</ul></article>)}</div>
    </div>
  </section>

  <section class="section philosophy-section">
    <div class="container philosophy-grid">
      <div class="philosophy-visual" aria-hidden="true"><div><span>ЗАДАЧА</span><i></i><span>РЕШЕНИЕ</span></div><b>BUSINESS<br />FIRST</b><small>VAV / APPROACH</small></div>
      <div class="philosophy-copy"><p class="eyebrow"><span></span> Подход VAV</p><h2>Не продаём «автоматизацию ради автоматизации».</h2><p>Сначала определяем бизнес-задачу, цену текущего ограничения и требуемый результат. Только затем выбираем процесс, инструмент или AI-сценарий.</p><ul><li>Проблема до продукта</li><li>Процесс до технологии</li><li>Данные до обещаний</li><li>Внедрение до отчёта</li></ul></div>
    </div>
  </section>

  <section class="section section--muted audit-entry">
    <div class="container">
      <AuditCard title="Начните с диагностики бизнеса" text="Диагностика помогает отделить симптомы от причин, согласовать приоритеты и не тратить ресурсы на преждевременные решения." items={audits} />
    </div>
  </section>

  <CTA />
</BaseLayout>

<style>
  .hero { overflow: hidden; padding-top: clamp(3.5rem, 6vw, 6rem); background: var(--surface); }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(22rem, .8fr); align-items: center; gap: clamp(3rem, 8vw, 8rem); }
  .hero__content { min-width: 0; }
  .hero__content h1 { max-width: 18ch; margin: 1.5rem 0; font-size: clamp(3rem, 5.2vw, 4.75rem); line-height: .99; letter-spacing: -.052em; }
  .hero__content h1 em { color: var(--accent); font-style: normal; }
  .hero__lead { max-width: 45rem; color: var(--muted-strong); font-size: var(--step-1); line-height: 1.65; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.25rem; }
  .system-map { position: relative; aspect-ratio: 1; max-width: 31rem; width: 100%; margin-inline: auto; border: 1px solid var(--line); border-radius: 50%; background: radial-gradient(circle at center, rgba(21,107,97,.08), transparent 43%), linear-gradient(var(--line-soft) 1px, transparent 1px), linear-gradient(90deg,var(--line-soft) 1px,transparent 1px); background-size: auto, 2rem 2rem, 2rem 2rem; }
  .system-map__axis { position: absolute; background: var(--line); }.system-map__axis--x { left: -12%; top: 50%; width: 124%; height: 1px; }.system-map__axis--y { top: -12%; left: 50%; height: 124%; width: 1px; }
  .system-map__core { position: absolute; z-index: 2; inset: 50% auto auto 50%; width: 8rem; aspect-ratio: 1; display: grid; place-items: center; translate: -50% -50%; border-radius: 50%; color: #fff; background: var(--ink); box-shadow: 0 1.5rem 4rem rgba(11,23,32,.2); text-align: center; }
  .system-map__core b { align-self: end; font-size: 1.35rem; letter-spacing: -.04em; }.system-map__core small { align-self: start; margin-top: .4rem; color: #aebac1; font-size: .55rem; line-height: 1.3; letter-spacing: .16em; }
  .system-map__orbit { position: absolute; inset: 20%; border: 1px solid var(--accent); border-radius: 50%; opacity: .35; animation: orbit 16s linear infinite; }.system-map__orbit::after { content: ''; position: absolute; top: 48%; left: -.28rem; width: .55rem; aspect-ratio: 1; border-radius: 50%; background: var(--accent); }.orbit-two { inset: 7%; border-color: var(--line); animation-direction: reverse; animation-duration: 22s; }.orbit-two::after { top: 16%; left: 81%; }
  @keyframes orbit { to { rotate: 360deg; } }
  .system-map__label { position: absolute; z-index: 3; padding: .5rem .65rem; border: 1px solid var(--line); border-radius: .4rem; color: var(--muted); background: var(--surface); box-shadow: var(--shadow-sm); font-size: .57rem; font-weight: 700; letter-spacing: .12em; }
  .label-a { top: 7%; left: 18%; }.label-b { right: -2%; top: 36%; }.label-c { left: 4%; bottom: 20%; }.label-d { right: 18%; bottom: 5%; color: var(--accent); border-color: color-mix(in srgb,var(--accent) 35%,white); }
  .hero__foot { display: flex; align-items: center; gap: 1.3rem; margin-top: clamp(4rem, 9vw, 8rem); padding-block: 1.35rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .68rem; font-weight: 660; letter-spacing: .09em; text-transform: uppercase; }.hero__foot span { height: 1px; flex: 1; background: var(--line); }
  .problems-section { border-top: 1px solid var(--line); }
  .problems-grid { display: grid; grid-template-columns: repeat(2, 1fr); padding: 0; border-top: 1px solid var(--line); list-style: none; }
  .problems-grid li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.3rem 0; border-bottom: 1px solid var(--line); }.problems-grid li:nth-child(odd) { padding-right: 2rem; border-right: 1px solid var(--line); }.problems-grid li:nth-child(even) { padding-left: 2rem; }
  .problems-grid span { color: var(--accent); font-family: var(--mono); font-size: .63rem; }.problems-grid p { font-weight: 590; }
  .seven-steps { --steps: 7; overflow-x: auto; padding-bottom: .25rem; }.seven-steps :global(.process-steps) { min-width: 68rem; }
  .directions-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; }
  .improve-grid { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid #263943; }
  .improve-grid article { min-height: 23rem; padding: 1.5rem; border-right: 1px solid #263943; }.improve-grid article:last-child { border-right: 0; }
  .improve-grid article > div { display: flex; justify-content: space-between; color: #70818a; font-family: var(--mono); font-size: .6rem; }.improve-grid article > div span { color: #70b7aa; }.improve-grid h3 { margin-top: 5rem; font-size: var(--step-2); }.improve-grid ul { display: grid; gap: .85rem; margin-top: 2rem; padding: 0; list-style: none; }.improve-grid li { padding-bottom: .85rem; border-bottom: 1px solid #263943; color: #b7c1c6; font-size: .84rem; }
  .philosophy-grid { display: grid; grid-template-columns: minmax(22rem,.85fr) minmax(0,1.15fr); align-items: center; gap: clamp(3rem, 9vw, 9rem); }
  .philosophy-visual { aspect-ratio: 1; display: grid; place-items: center; align-content: center; gap: 2rem; padding: 2rem; border: 1px solid var(--line); border-radius: 50%; background: radial-gradient(circle,#f3f6f4 0 35%,transparent 36%),linear-gradient(var(--line-soft) 1px,transparent 1px),linear-gradient(90deg,var(--line-soft) 1px,transparent 1px); background-size: auto, 2rem 2rem, 2rem 2rem; text-align: center; }.philosophy-visual > div { width: 80%; display: flex; align-items: center; gap: .6rem; color: var(--muted); font-family: var(--mono); font-size: .55rem; }.philosophy-visual i { height: 1px; flex: 1; background: var(--accent); }.philosophy-visual b { font-size: var(--step-3); line-height: 1; letter-spacing: -.05em; }.philosophy-visual small { color: var(--accent); font-family: var(--mono); font-size: .56rem; letter-spacing: .12em; }
  .philosophy-copy h2 { max-width: 16ch; margin-top: 1.3rem; font-size: var(--step-4); line-height: 1.06; letter-spacing: -.045em; }.philosophy-copy > p:not(.eyebrow) { max-width: 42rem; margin-top: 1.4rem; color: var(--muted-strong); line-height: 1.68; }.philosophy-copy ul { display: grid; grid-template-columns: 1fr 1fr; gap: 1px; margin-top: 2rem; padding: 1px; background: var(--line); list-style: none; }.philosophy-copy li { padding: 1rem; background: var(--surface); font-size: .8rem; font-weight: 650; }
  .cases-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .cases-section__actions { display: flex; justify-content: flex-end; margin-top: 2rem; }
  @media (max-width: 980px) { .hero__grid, .philosophy-grid { grid-template-columns: 1fr; } .system-map, .philosophy-visual { max-width: 27rem; } .improve-grid { grid-template-columns: 1fr 1fr; }.improve-grid article:nth-child(2) { border-right: 0; }.improve-grid article:nth-child(-n+2) { border-bottom: 1px solid #263943; } }
  @media (max-width: 720px) { .hero__foot { display: grid; grid-template-columns: 1fr 1fr; }.hero__foot span { display: none; }.directions-grid, .cases-grid { grid-template-columns: 1fr; }.problems-grid { grid-template-columns: 1fr; }.problems-grid li:nth-child(odd), .problems-grid li:nth-child(even) { padding-inline: 0; border-right: 0; } }
  @media (max-width: 500px) { .hero__content h1 { max-width: none; font-size: clamp(1.95rem, 9vw, 2.35rem); overflow-wrap: anywhere; hyphens: none; }.hero__actions { align-items: stretch; flex-direction: column; }.system-map { width: 100%; margin-left: 0; }.improve-grid { grid-template-columns: 1fr; }.improve-grid article, .improve-grid article:nth-child(2) { min-height: auto; border-right: 0; border-bottom: 1px solid #263943; }.improve-grid article:last-child { border-bottom: 0; }.improve-grid h3 { margin-top: 3rem; }.philosophy-grid { grid-template-columns: minmax(0,1fr); }.philosophy-visual { width: 100%; margin-left: 0; }.philosophy-copy ul { grid-template-columns: 1fr; } }
</style>
