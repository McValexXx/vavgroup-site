---
interface Props {
  compact?: boolean;
  inverse?: boolean;
}

const { compact = false, inverse = false } = Astro.props;
---

<span class:list={["logo", { "logo--compact": compact, "logo--inverse": inverse }]} aria-label="VAV Group">
  <svg class="logo__mark" viewBox="0 0 40 40" aria-hidden="true">
    <rect x="1" y="1" width="38" height="38" rx="10" fill="currentColor" />
    <path d="M9 12.5 15.8 28h3.8l2.7-6.1L25 28h3.8L35.6 12.5h-4.2l-4.5 10.9-4.7-10.9h-3.7l1.7 4.1-2.4 6-4.5-10.1H9Z" fill="var(--logo-cut, #fff)" />
  </svg>
  <span class="logo__word" aria-hidden="true">
    <strong>VAV</strong>
    <small>GROUP</small>
  </span>
</span>

<style>
  .logo { display: inline-flex; align-items: center; gap: .7rem; color: var(--ink); --logo-cut: var(--surface); }
  .logo__mark { width: 2.25rem; height: 2.25rem; flex: none; }
  .logo__word { display: grid; line-height: .92; letter-spacing: -.04em; }
  .logo__word strong { font-size: 1.06rem; font-weight: 750; }
  .logo__word small { margin-top: .24rem; color: var(--muted); font-size: .55rem; font-weight: 700; letter-spacing: .19em; }
  .logo--compact .logo__word { display: none; }
  .logo--inverse { color: #fff; --logo-cut: var(--ink); }
  .logo--inverse .logo__word small { color: #aab4c0; }
</style>
