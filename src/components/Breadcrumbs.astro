---
interface Item { label: string; href?: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Хлебные крошки">
  <ol>
    {items.map((item, index) => (
      <li>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        {index < items.length - 1 && <span class="separator" aria-hidden="true">/</span>}
      </li>
    ))}
  </ol>
</nav>

<style>
  ol { display: flex; flex-wrap: wrap; gap: .55rem; margin: 0; padding: 0; list-style: none; color: var(--muted); font-size: .72rem; }
  li { display: inline-flex; gap: .55rem; }
  a:hover { color: var(--ink); }
  .separator { color: #acb5b0; }
</style>
