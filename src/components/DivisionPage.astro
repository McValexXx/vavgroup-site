---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import SectionHeader from './SectionHeader.astro';
import ProcessSteps from './ProcessSteps.astro';
import AuditCard from './AuditCard.astro';
import CTA from './CTA.astro';
import type { Division } from '@/data/divisions';

interface Props { division: Division }
const { division } = Astro.props;
---

<BaseLayout title={division.metaTitle} description={division.metaDescription}>
  <section class="division-hero grid-lines">
    <div class="container">
      <Breadcrumbs items={[{ label: 'VAV Group', href: '/' }, { label: division.name }]} />
      <div class="division-hero__grid">
        <div>
          <p class="eyebrow"><span></span>{division.eyebrow}</p>
          <h1>{division.title}</h1>
          <p class="division-hero__lead">{division.lead}</p>
          <div class="division-hero__actions"><a class="button" href="/contacts">Обсудить задачу <span aria-hidden="true">↗</span></a><a class="button button--secondary" href="#solutions">Посмотреть решения</a></div>
        </div>
        <aside class="division-hero__panel">
          <div class="division-hero__panel-head"><span>{division.number}</span><span>VAV GROUP / DIVISION</span></div>
          <h2>{division.name}</h2>
          <dl><div><dt>Фокус</dt><dd>{division.cardProblem}</dd></div><div><dt>Результат</dt><dd>{division.cardOutcome}</dd></div></dl>
        </aside>
      </div>
    </div>
  </section>

  <section class="problem-strip">
    <div class="container problem-strip__inner"><span aria-hidden="true">“</span><div><h2>{division.problemTitle}</h2><p>{division.problemText}</p></div></div>
  </section>

  <section id="solutions" class="section">
    <div class="container">
      <SectionHeader eyebrow="Что делаем" title="Работаем с системой целиком." text="Объём проекта зависит от исходной задачи: отдельный процесс, направление или связанная программа изменений." />
      <div class="capabilities">
        {division.capabilities.map((capability, index) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{capability.title}</h3><p>{capability.text}</p></article>)}
      </div>
    </div>
  </section>

  <section class="section outcomes-section">
    <div class="container outcomes-grid">
      <div><p class="eyebrow"><span></span> Результат работы</p><h2>Что получает бизнес</h2><p>Конкретный состав результатов фиксируется на старте проекта. Мы не подменяем работу обещаниями неподтверждённых показателей.</p></div>
      <ol>{division.outcomes.map((outcome, index) => <li><span>{String(index + 1).padStart(2, '0')}</span><p>{outcome}</p></li>)}</ol>
    </div>
  </section>

  <section class="section section--muted">
    <div class="container">
      <SectionHeader eyebrow="Логика проекта" title="От фактов — к работающему изменению." text="Каждый этап заканчивается проверяемым результатом и создаёт основу для следующего решения." />
      <ProcessSteps steps={division.process} />
    </div>
  </section>

  <section class="principle section--dark">
    <div class="container principle__grid"><p>Принцип VAV</p><blockquote>{division.principle}</blockquote></div>
  </section>

  {division.boundaries && <section class="section boundaries"><div class="container boundaries__grid"><div><p class="eyebrow"><span></span> Границы применения</p><h2>{division.boundaries.title}</h2></div><ul>{division.boundaries.items.map((item) => <li><span aria-hidden="true">×</span>{item}</li>)}</ul></div></section>}

  <section class="section audit-section"><div class="container"><AuditCard title={division.auditTitle} text={division.auditText} items={division.auditItems} /></div></section>
  <CTA />
</BaseLayout>

<style>
  .division-hero { padding-block: 2rem clamp(5rem, 10vw, 8.5rem); }
  .division-hero__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(20rem, .7fr); align-items: end; gap: clamp(3rem, 8vw, 7rem); margin-top: clamp(4rem, 8vw, 7rem); }
  .division-hero h1 { max-width: 18ch; margin-top: 1.4rem; font-size: clamp(3rem, 4.8vw, 4.6rem); line-height: 1.01; letter-spacing: -.052em; }
  .division-hero__lead { max-width: 47rem; margin-top: 1.7rem; color: var(--muted-strong); font-size: var(--step-1); line-height: 1.62; }
  .division-hero__actions { display: flex; flex-wrap: wrap; gap: .8rem; margin-top: 2.2rem; }
  .division-hero__panel { padding: 1.6rem; border: 1px solid var(--line); background: color-mix(in srgb, var(--surface) 92%, transparent); box-shadow: var(--shadow-sm); }
  .division-hero__panel-head { display: flex; justify-content: space-between; padding-bottom: 1rem; border-bottom: 1px solid var(--line); color: var(--muted); font-family: var(--mono); font-size: .58rem; letter-spacing: .08em; }
  .division-hero__panel-head span:first-child { color: var(--accent); }
  .division-hero__panel h2 { margin-top: 2.5rem; font-size: var(--step-2); letter-spacing: -.03em; }
  dl { display: grid; gap: 1.2rem; margin: 2.4rem 0 0; }
  dl div { padding-top: 1rem; border-top: 1px solid var(--line); }
  dt { color: var(--muted); font-size: .62rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  dd { margin: .45rem 0 0; color: var(--muted-strong); font-size: .86rem; line-height: 1.55; }
  .problem-strip { padding-block: clamp(3rem, 6vw, 5rem); color: #fff; background: var(--surface-dark); }
  .problem-strip__inner { display: grid; grid-template-columns: auto 1fr; gap: 1.5rem; }
  .problem-strip__inner > span { color: var(--accent); font-family: Georgia, serif; font-size: 5rem; line-height: .7; }
  .problem-strip h2 { max-width: 35ch; font-size: var(--step-3); line-height: 1.14; letter-spacing: -.035em; }
  .problem-strip p { max-width: 50rem; margin-top: 1.1rem; color: #aeb9bf; line-height: 1.65; }
  .capabilities { display: grid; grid-template-columns: repeat(3, 1fr); border: 1px solid var(--line); }
  .capabilities article { min-height: 15.5rem; padding: 1.5rem; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .capabilities article:nth-child(3n) { border-right: 0; }
  .capabilities article:nth-last-child(-n+3) { border-bottom: 0; }
  .capabilities article > span { color: var(--accent); font-family: var(--mono); font-size: .64rem; }
  .capabilities h3 { margin-top: 3.5rem; font-size: 1.2rem; }
  .capabilities p { margin-top: .75rem; color: var(--muted); font-size: .86rem; line-height: 1.6; }
  .outcomes-section { border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .outcomes-grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: clamp(3rem, 8vw, 8rem); }
  .outcomes-grid h2 { margin-top: 1.2rem; font-size: var(--step-3); letter-spacing: -.04em; }
  .outcomes-grid > div > p:last-child { max-width: 32rem; margin-top: 1rem; color: var(--muted); line-height: 1.65; }
  .outcomes-grid ol { padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .outcomes-grid li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.35rem 0; border-bottom: 1px solid var(--line); }
  .outcomes-grid li span { color: var(--accent); font-family: var(--mono); font-size: .65rem; }
  .outcomes-grid li p { font-size: 1.05rem; font-weight: 620; }
  .principle { padding-block: clamp(4rem, 8vw, 7rem); }
  .principle__grid { display: grid; grid-template-columns: .35fr 1.65fr; gap: 3rem; }
  .principle__grid > p { color: #7f8e96; font-size: .66rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }
  blockquote { max-width: 34ch; margin: 0; font-size: var(--step-3); line-height: 1.28; letter-spacing: -.025em; }
  .boundaries__grid { display: grid; grid-template-columns: .8fr 1.2fr; gap: clamp(3rem, 8vw, 8rem); }
  .boundaries h2 { max-width: 13ch; margin-top: 1.2rem; font-size: var(--step-3); letter-spacing: -.04em; }
  .boundaries ul { padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .boundaries li { display: flex; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); color: var(--muted-strong); line-height: 1.5; }
  .boundaries li span { color: var(--danger); }
  @media (max-width: 900px) { .division-hero__grid, .outcomes-grid, .boundaries__grid { grid-template-columns: 1fr; } .division-hero__panel { max-width: 40rem; } .capabilities { grid-template-columns: 1fr 1fr; } .capabilities article:nth-child(3n) { border-right: 1px solid var(--line); } .capabilities article:nth-child(2n) { border-right: 0; } .capabilities article:nth-last-child(-n+3) { border-bottom: 1px solid var(--line); } .capabilities article:nth-last-child(-n+2) { border-bottom: 0; } }
  @media (max-width: 580px) { .division-hero h1 { max-width: none; font-size: clamp(2rem, 9vw, 2.55rem); overflow-wrap: anywhere; } .division-hero__actions { align-items: stretch; flex-direction: column; } .problem-strip__inner { grid-template-columns: 1fr; } .problem-strip__inner > span { font-size: 4rem; } .capabilities { grid-template-columns: 1fr; } .capabilities article, .capabilities article:nth-child(2n), .capabilities article:nth-child(3n), .capabilities article:nth-last-child(-n+2) { min-height: auto; border-right: 0; border-bottom: 1px solid var(--line); } .capabilities article:last-child { border-bottom: 0; } .capabilities h3 { margin-top: 2.25rem; } .principle__grid { grid-template-columns: 1fr; gap: 1.5rem; } }
</style>
