---
import Logo from './Logo.astro';
import { divisions } from '@/data/divisions';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a href="/" aria-label="VAV Group — главная"><Logo inverse /></a>
      <p>Business. Sales.<br />Automation. Growth.</p>
    </div>
    <nav aria-label="Направления VAV Group"><p>Направления</p>{divisions.map((division) => <a href={division.href}>{division.name}</a>)}</nav>
    <nav aria-label="Информация"><p>Компания</p><a href="/cases">Кейсы</a><a href="/about">О VAV Group</a><a href="/contacts">Контакты</a><a href="/privacy">Конфиденциальность</a></nav>
    <div class="footer-contact"><p>Связаться</p><span class="footer-contact__name">Валентин Стратила</span><a href="mailto:valentin@vavgroup.pro">valentin@vavgroup.pro</a><a href="tel:+79224615517">+7 (922) 461-55-17</a><a class="footer-contact__cta" href="/contacts">Обсудить задачу <span aria-hidden="true">↗</span></a></div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} VAV Group</span><span>Системы роста бизнеса</span><span>vavgroup.pro</span>
  </div>
</footer>

<style>
  .site-footer { color: #d8dfe2; background: #071117; }
  .footer-main { display: grid; grid-template-columns: 1.2fr 1fr .75fr 1.2fr; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(4rem, 8vw, 7rem); }
  .footer-brand > p { margin-top: 2rem; color: #819098; font-size: .78rem; font-weight: 650; line-height: 1.7; letter-spacing: .1em; text-transform: uppercase; }
  nav, .footer-contact { display: grid; align-content: start; gap: .85rem; }
  nav > p, .footer-contact > p { margin-bottom: .35rem; color: #6f7f87; font-size: .62rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; }
  nav a, .footer-contact a { color: #b8c2c7; font-size: .82rem; }
  .footer-contact__name { color: #f1f4f3; font-size: .82rem; }
  nav a:hover, .footer-contact a:hover { color: #fff; }
  .footer-contact__cta { display: flex; justify-content: space-between; margin-top: 1.2rem; padding: 1rem 0; border-top: 1px solid #24343d; border-bottom: 1px solid #24343d; }
  .footer-contact__cta span { color: #70b7aa; }
  .footer-bottom { display: flex; justify-content: space-between; gap: 1rem; padding-block: 1.3rem; border-top: 1px solid #1b2b34; color: #6f7f87; font-family: var(--mono); font-size: .58rem; letter-spacing: .08em; text-transform: uppercase; }
  @media (max-width: 860px) { .footer-main { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 530px) { .footer-main { grid-template-columns: 1fr; } .footer-bottom { flex-direction: column; } }
</style>
